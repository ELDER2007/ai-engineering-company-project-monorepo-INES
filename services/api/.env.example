# Copy to .env; it is loaded automatically on startup (see README, "Authentication").
# Required in production. At least 32 chars: openssl rand -hex 32
SECRET_KEY=
# Optional. Access token lifetime in minutes (default 30).
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional. Creates the first user on startup if the user store is empty.
AUTH_INITIAL_EMAIL=
AUTH_INITIAL_PASSWORD=
# Optional. Comma-separated CORS origins (defaults to the local Vite dev servers).
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Inventory (assets and orders) database. Supabase: Connect -> Transaction pooler -> URI.
# Users and sessions stay in TinyDB and never use this connection.
# Leave it empty to use a local SQLite file (inventory/db.sqlite) in development.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional. Key of the telemetry userId pseudonym (HMAC-SHA256), at least 32 chars, separate per environment.
# If unset it is derived from SECRET_KEY (fine for development; the pseudonyms then change with SECRET_KEY).
# TELEMETRY_HMAC_KEY=
# Optional. Informational: an external collector, logged at startup and NOT used. POST /telemetry/events stores the events in the
# database above (table telemetry_events). Not the frontend's NEXT_PUBLIC_TELEMETRY_ENDPOINT.
# TELEMETRY_ENDPOINT=
