# Copy to .env; it is loaded automatically on startup (see README, "Authentication").
# Required in production. At least 32 chars: openssl rand -hex 32
SECRET_KEY=
# Optional. Access token lifetime in minutes (default 30).
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional. Creates the first user on startup if the user store is empty.
AUTH_INITIAL_EMAIL=
AUTH_INITIAL_PASSWORD=
# Optional. Comma-separated CORS origins (defaults to the local Vite dev servers).
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Password reset and email ---
# Optional. Lifetime of a password-reset link in minutes (default 30, allowed 15-60).
PASSWORD_RESET_EXPIRE_MINUTES=30
# Base URL of the backoffice: the reset link in the email is FRONTEND_URL/reset-password?token=...
# Defaults to the Codespace's forwarded URL for port 5174, or http://localhost:5174. Set it in production.
# FRONTEND_URL=https://backoffice.nexova.com
# How emails are sent: console (default: printed to the API's stdout, not sent), smtp or resend.
EMAIL_BACKEND=console
# Sender. Required for smtp and resend, and it must be an address/domain your provider has verified.
# EMAIL_FROM=Nexova <no-reply@nexova.com>
# EMAIL_BACKEND=smtp: any SMTP relay (Resend, SendGrid, Mailgun, Brevo, Amazon SES, Mailtrap...).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# starttls (default, port 587) | ssl (port 465) | none (local test servers only)
# SMTP_SECURITY=starttls
# EMAIL_BACKEND=resend: Resend's HTTP API.
# RESEND_API_KEY=
