# Copia a .env (gitignored). Nunca subas valores reales a Git.
SECRET_KEY=                       # openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_INITIAL_EMAIL=
AUTH_INITIAL_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=                     # vacío = SQLite local
API_PROXY_TARGET=http://api:8000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_INVENTORY_API_URL=http://api:8000
API_PORT=8000
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
# Si abres el backoffice por una IP o dominio (p. ej. un VPS), ponlo aquí: DEV_ALLOWED_ORIGINS=64.226.96.129
DEV_ALLOWED_ORIGINS=
# --- Asynchronous tasks (Celery + Redis + Flower). All optional: docker compose up works without them.
# Redis, for the API and the worker when they run OUTSIDE Docker. Inside docker compose the host is the service name ("redis"): see REDIS_URL_DOCKER.
REDIS_URL=redis://localhost:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0   # only to point the containers at another Redis (a managed one on a VPS)
REDIS_PORT=6379                         # published on 127.0.0.1 only
REDIS_MAXMEMORY=256mb                   # with noeviction: when full, Redis refuses new tasks (the API answers 503) instead of deleting queued ones
FLOWER_BASIC_AUTH=admin:admin           # user:password of the panel. CHANGE IT anywhere that is not your own laptop
FLOWER_PORT=5555
CELERY_CONCURRENCY=1                    # tasks at once per worker; each pipeline run starts its own Prefect server
ASYNC_RETRY_BASE_SECONDS=5              # wait before the first retry; it doubles every time
